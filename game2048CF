#ifndef GAME2048_HELPER_H
#define GAME2048_HELPER_H

const int BOARD_SIZE = 5;

// Moves every row as far left as possible.
// Returns true if the board changed and stores the points earned in scoreGained.
bool move_left(int board[BOARD_SIZE][BOARD_SIZE], int& scoreGained);

#endif

#include "2048_helper.h"

// Slides the nonzero values in one row to the left, merges equal neighbors
// once, then closes any gaps created by merging.
void process_row_left(int row[BOARD_SIZE], int& scoreGained)
{
    int compacted[BOARD_SIZE] = {0, 0, 0, 0, 0};
    int nextPosition = 0;

    // Step 1: Move all nonzero values together.
    for (int i = 0; i < BOARD_SIZE; i++)
    {
        if (row[i] != 0)
        {
            compacted[nextPosition] = row[i];
            nextPosition++;
        }
    }

    // Step 2: Merge equal neighboring values.
    // After a merge, skip the next position so a new tile cannot merge again.
    for (int i = 0; i < BOARD_SIZE - 1; i++)
    {
        if (compacted[i] != 0 && compacted[i] == compacted[i + 1])
        {
            compacted[i] = compacted[i] * 2;
            scoreGained += compacted[i];
            compacted[i + 1] = 0;
            i++;
        }
    }

    // Step 3: Close the gaps left by merging.
    int finalRow[BOARD_SIZE] = {0, 0, 0, 0, 0};
    nextPosition = 0;

    for (int i = 0; i < BOARD_SIZE; i++)
    {
        if (compacted[i] != 0)
        {
            finalRow[nextPosition] = compacted[i];
            nextPosition++;
        }
    }

    // Copy the finished row back into the board.
    for (int i = 0; i < BOARD_SIZE; i++)
    {
        row[i] = finalRow[i];
    }
}

bool move_left(int board[BOARD_SIZE][BOARD_SIZE], int& scoreGained)
{
    scoreGained = 0;
    bool boardChanged = false;

    for (int r = 0; r < BOARD_SIZE; r++)
    {
        int originalRow[BOARD_SIZE];

        // Save the row so we can tell whether anything changed.
        for (int c = 0; c < BOARD_SIZE; c++)
        {
            originalRow[c] = board[r][c];
        }

        process_row_left(board[r], scoreGained);

        // Compare the new row with the original row.
        for (int c = 0; c < BOARD_SIZE; c++)
        {
            if (board[r][c] != originalRow[c])
            {
                boardChanged = true;
            }
        }
    }

    return boardChanged;
}
